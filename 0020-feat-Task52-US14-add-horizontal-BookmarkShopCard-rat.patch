Subject: [PATCH 20/21] feat(Task52/US14): add horizontal BookmarkShopCard
 (rating, close time, call, details) per Figma

---
 client/src/components/BookmarkShopCard.jsx | 109 +++++++++++++++++++++
 1 file changed, 109 insertions(+)
 create mode 100644 client/src/components/BookmarkShopCard.jsx

diff --git a/client/src/components/BookmarkShopCard.jsx b/client/src/components/BookmarkShopCard.jsx
new file mode 100644
index 0000000..882385a
--- /dev/null
+++ b/client/src/components/BookmarkShopCard.jsx
@@ -0,0 +1,109 @@
+// client/src/components/BookmarkShopCard.jsx
+// US14 / Task52: การ์ดร้านโปรดแนวนอน (อิง Figma: Bookmarks)
+// มีรูปย่อ+คะแนน ชื่อร้าน สถานะเปิด/ปิด (ปิดกี่โมง) ข้อความจากร้าน ปุ่มดูรายละเอียด โทร และหัวใจ
+
+import React, { useState, useEffect } from 'react';
+import { UtensilsCrossed, Star, Store, Phone, Heart, MapPin, Bell, Info } from 'lucide-react';
+import { getOpeningHours } from '../services/api';
+import { getTodayRow } from '../utils/openingHours';
+
+export default function BookmarkShopCard({ shop, onSelect, onToggleBookmark }) {
+  const [closeTime, setCloseTime] = useState(null);
+
+  // ดึงเวลาปิดของวันนี้ไว้แสดงใน "เปิดอยู่ (ปิด 20:00)"
+  useEffect(() => {
+    let cancelled = false;
+    getOpeningHours(shop.id)
+      .then((rows) => {
+        const today = getTodayRow(rows);
+        if (!cancelled && today && !today.is_closed) setCloseTime(today.close_time);
+      })
+      .catch(() => {});
+    return () => {
+      cancelled = true;
+    };
+  }, [shop.id]);
+
+  const isOpen = shop.isOpen;
+  const accent = shop.accentColor || '#F97316';
+
+  return (
+    <div className="p-3.5 bg-white rounded-2xl border border-slate-100 shadow-sm space-y-3">
+      <div className="flex gap-3">
+        {/* รูปย่อ (ยังไม่มีรูปร้านในข้อมูล จึงใช้ไทล์สีประจำร้านแทน) */}
+        <div
+          className="relative w-[88px] h-[88px] rounded-xl flex-shrink-0 flex items-center justify-center text-white/90"
+          style={{ background: `linear-gradient(135deg, ${accent}, ${accent}99)` }}
+        >
+          <UtensilsCrossed className="w-8 h-8" />
+          {shop.rating != null && (
+            <span className="absolute top-1.5 left-1.5 inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-md bg-white/90 text-[11px] font-bold text-slate-800">
+              <Star className="w-3 h-3 text-orange-500" fill="currentColor" /> {shop.rating}
+            </span>
+          )}
+        </div>
+
+        <div className="min-w-0 flex-1">
+          <h3 className="text-base font-bold text-slate-900 leading-tight">{shop.name}</h3>
+          <p className="text-xs text-slate-600 mt-0.5">{shop.categoryName} • {shop.canteenName}</p>
+          <div className="mt-2 flex items-center gap-1.5 flex-wrap">
+            {isOpen ? (
+              <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-200 text-emerald-900">
+                <span className="w-2 h-2 rounded-full bg-emerald-600 animate-live" />
+                เปิดอยู่{closeTime ? ` (ปิด ${closeTime})` : ''}
+              </span>
+            ) : (
+              <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-200 text-rose-900">
+                <span className="w-2 h-2 rounded-full bg-rose-600" />
+                ปิดแล้ว
+              </span>
+            )}
+            <span className="inline-flex items-center gap-1 px-2 py-1 rounded-full text-[11px] font-medium bg-indigo-50 text-slate-700">
+              <MapPin className="w-3 h-3" /> {shop.boothNumber}
+            </span>
+          </div>
+        </div>
+      </div>
+
+      {/* ข้อความจากร้าน */}
+      {shop.statusNote && (
+        <div
+          className={`flex items-start gap-2 px-3 py-2 rounded-xl text-xs ${
+            isOpen ? 'bg-indigo-50 text-slate-800' : 'bg-rose-100 text-rose-900'
+          }`}
+        >
+          {isOpen ? <Info className="w-3.5 h-3.5 mt-0.5 flex-shrink-0" /> : <Bell className="w-3.5 h-3.5 mt-0.5 flex-shrink-0" />}
+          <span className="font-medium">{shop.statusNote}</span>
+        </div>
+      )}
+
+      {/* ปุ่มการทำงาน */}
+      <div className="flex gap-2">
+        <button
+          type="button"
+          onClick={() => onSelect(shop)}
+          className="flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-xl bg-orange-100 hover:bg-orange-200 text-orange-950 text-xs font-bold transition active:scale-95"
+        >
+          <Store className="w-4 h-4" /> ดูรายละเอียด & พิกัด
+        </button>
+        {shop.phone && (
+          <a
+            href={`tel:${shop.phone}`}
+            className="flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-slate-900 text-xs font-bold transition active:scale-95"
+          >
+            <Phone className="w-4 h-4 text-orange-700" /> โทรสอบถาม
+          </a>
+        )}
+        <button
+          type="button"
+          onClick={onToggleBookmark}
+          aria-label={`เอา ${shop.name} ออกจากร้านโปรด`}
+          title="เอาออกจากร้านโปรด"
+          className="px-3.5 rounded-xl bg-rose-100 hover:bg-rose-200 text-rose-700 transition active:scale-95"
+        >
+          <Heart className="w-4 h-4" fill="currentColor" />
+        </button>
+      </div>
+    </div>
+  );
+}
-- 
