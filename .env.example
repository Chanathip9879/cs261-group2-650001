# ===== HiwKhaw environment =====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้รหัสผ่านก่อนรัน (.env ถูก gitignore ไว้ ห้าม commit)

PORT=5000

# --- Database driver ---
# mssql = SQL Server (ค่าเริ่มต้น)
# json  = ใช้ไฟล์ server/data/database.json แบบเดิม (fallback)
DB_DRIVER=mssql

# --- MSSQL connection ---
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ChangeMe!2026
DB_NAME=hiwkhaw
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# สร้าง database/ตาราง/seed อัตโนมัติตอน start server (false = ปิด)
DB_AUTO_INIT=true
# true = ล้างข้อมูลแล้ว seed ใหม่ทุกครั้งที่ start (ใช้เฉพาะตอน dev)
DB_AUTO_RESET=false

# --- Docker SQL Server password (ใช้ใน docker-compose.yml) ---
# ต้องเป็นรหัสที่ผ่านข้อกำหนดของ SQL Server: ตัวพิมพ์ใหญ่+เล็ก+ตัวเลข+สัญลักษณ์
MSSQL_SA_PASSWORD=ChangeMe!2026
